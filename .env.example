# Copy this file to .env and replace the placeholder values.

DJANGO_SECRET_KEY=replace-with-your-own-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=news_db
DB_USER=news_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=3306

MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
